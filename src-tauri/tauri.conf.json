{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Owlet",
  "version": "0.8.3",
  "identifier": "com.burny.owlet.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Owlet",
        "width": 180,
        "height": 80,
        "minWidth": 180,
        "minHeight": 80,
        "maxWidth": 180,
        "maxHeight": 80,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "url": "widget.html"
      },
      {
        "label": "settings",
        "title": "Nightscout Widget Settings",
        "width": 800,
        "height": 530,
        "minWidth": 800,
        "minHeight": 530,
        "maxWidth": 800,
        "maxHeight": 530,
        "resizable": false,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "visible": false,
        "parent": "main",
        "url": "settings.html"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../asset/icons/png/32x32.png",
      "../asset/icons/png/128x128.png",
      "../asset/icons/png/256x256.png",
      "../asset/icons/png/512x512.png",
      "../asset/icons/png/1024x1024.png"
    ],
    "resources": [
      "../localization/**/*",
      "../js/**/*",
      "../asset/**/*",
      "../styles.css",
      "../widget.html",
      "../settings.html"
    ],
    "copyright": "",
    "category": "Health",
    "shortDescription": "Nightscout widget for desktop",
    "longDescription": "An Electron widget application to show on a desktop sgv (sensor glucose value) is getting from Nightscout API",
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.13",
      "exceptionDomain": "",
      "signingIdentity": null,
      "entitlements": null
    }
  },
  "plugins": {
    "store": {},
    "dialog": {},
    "shell": {},
    "updater": {
      "active": true,
      "endpoints": [
        "https://api.github.com/repos/kashamalasha/nightscout-widget-electron/releases/latest"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
